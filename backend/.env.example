# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000

# ── Frontend (CORS) ──────────────────────────────────────────────────────────
# Coma-separado si tenés varios orígenes
FRONTEND_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────────────────────
# Obtener desde: Supabase Dashboard > Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-publishable-key

# Service Role Key — SECRETO, solo backend, bypassa RLS (necesario para storage)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar uno seguro, ej: openssl rand -base64 48
JWT_SECRET=cambiame-en-produccion-por-algo-largo-y-aleatorio

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generar el par con: node scripts/generate-vapid.js
# La PRIVADA es un secreto (solo backend). La pública también va al frontend
# como VITE_VAPID_PUBLIC_KEY (frontend/.env.local y Vercel).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que reciben los servicios push (un mail tuyo real)
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com
